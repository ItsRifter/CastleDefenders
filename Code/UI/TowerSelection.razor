@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>

    <div class="icons">

        @for (int i = 0; i < towerIcons.Length; i++)
        {
            <div class="icon @towerIcons[i] @(selectionIndex == i+1 ? "isSelected" : "")"></div>
        }
       
    </div>
</root>

@code
{

    int selectionIndex = -1;
    int lastSelect = -1;

    string[] towerIcons = new string[]
    {
        "pistol", "smg", "shotgun", "cannon", "electric", "frost", "radar"
    };

    protected override void OnStart()
    {
        
    }

    protected override void OnUpdate()
    {
        HandleSelection();
    }

    void HandleSelection()
    {
        for (int i = 1; i <= towerIcons.Length; i++)
        {
            if (Input.Pressed($"Slot{i}"))
            {
                selectionIndex = i;
                return;
            }
        }

        // Holster remains special
        if (Input.Pressed("Holster"))
            selectionIndex = 0;
    }

    protected override int BuildHash() => System.HashCode.Combine(selectionIndex.GetHashCode());
}
