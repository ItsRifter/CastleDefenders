@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits PanelComponent
@namespace Sandbox

<root>

    <div class="icons">

        @for (int i = 0; i < towers.Count; i++)
        {
            var stats = towers[i];
            bool selected = selectionIndex == i + 1;
            bool canAfford = LocalPlayer != null && LocalPlayer.Money >= stats.Cost;
            <div class="icon @stats.Icon @(selected ? "isSelected" : "") @(!canAfford ? "cantAfford" : "")" >
                <img src="@stats.Icon" />
                <div class="cost">$@stats.Cost</div>
            </div>
        }
       
    </div>
</root>

@code
{

    int selectionIndex = -1;
    int lastSelect = -1;

    List<TowerStats> towers = new();

    CastlePlayer LocalPlayer => Scene.GetAll<CastlePlayer>().FirstOrDefault();

    protected override void OnStart()
    {
        RefreshTowerList();
    }

    void RefreshTowerList()
    {
        towers.Clear();
        var prefabs = CastleGame.Instance?.TowerPrefabs;
        if ( prefabs == null ) return;

        foreach ( var prefab in prefabs )
        {
            var stats = prefab?.GetComponent<TowerStats>();
            if ( stats != null )
                towers.Add( stats );
        }
    }

    protected override void OnUpdate()
    {
        HandleSelection();
    }

    void HandleSelection()
    {
        for (int i = 1; i <= towers.Count; i++)
        {
            if (Input.Pressed($"Slot{i}"))
            {
                selectionIndex = i;
                return;
            }
        }

        if (Input.Pressed("Holster"))
        {
            selectionIndex = 0;
            return;
        }

        if (!Input.Down("ALT"))
        {
            var scroll = -Input.MouseWheel.y;
            if (scroll != 0 && towers.Count > 0)
            {
                int next = selectionIndex <= 0 ? 1 : selectionIndex - Math.Sign(scroll);
                selectionIndex = ((next - 1 + towers.Count) % towers.Count) + 1;
            }
        }
    }

    protected override int BuildHash() => System.HashCode.Combine( selectionIndex, LocalPlayer?.Money ?? 0 );
}
