@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>
    <div>@curMessage</div>
</root>

@code
{
    string curMessage;
    int curWave;
    int maxWaves;
    WaveManager.WaveState curState;

    public static WaveDisplay Instance;

    protected override void OnStart()
    {
        Instance = this;
        curMessage = "";
    }

    public void SetStatus(WaveManager.WaveState newState) => curState = newState;

    public void SetWave(int newWave, int newMaxWaves = -1)
    {
        curWave = newWave;

        if(newMaxWaves != -1)
            maxWaves = newMaxWaves;
    }

    public void UpdateText()
    {
        switch(curState)
        {
            case WaveManager.WaveState.Inactive:
                curMessage = "Inactive";
                break;

            case WaveManager.WaveState.Idle:
                curMessage = "";
                break;

            case WaveManager.WaveState.Active:
                curMessage = $"Wave {curWave}/{maxWaves}";
                break;

            case WaveManager.WaveState.Completed:
                curMessage = "";
                break;
        }
    }

    [ConCmd("TestText")]
    public static void Test()
    {
        Instance.curMessage = "TEST";
    }

    protected override int BuildHash() => curMessage.GetHashCode();
}
